+static int
+kickstart_cmd(int argc, char *const argv[])
+{
+	if (argc < 2) {
+		fprintf(stderr, "usage: kickstart <service-target>\n");
+		return EX_USAGE;
 	}
+	return start_stop_remove_cmd(argc, argv);
 }
