+static int
+error_cmd(int argc, char *const argv[])
+{
+	if (argc < 2) {
+		fprintf(stderr, "usage: error <number>\n");
+		return EX_USAGE;
+	}
+	char *end = NULL;
+	long n = strtol(argv[1], &end, 0);
+	if (end && *end) {
+		fprintf(stderr, "error: invalid number\n");
+		return EX_USAGE;
+	}
+	fprintf(stdout, "%s\n", strerror((int)n));
+	return 0;
+}
