.DS_Store
*.o
*.a
*.dylib
*.o.tmp
*.tmp
build/

# Debug symbol bundles
*.dSYM/

# External reference material — never commit
local/

# Stray debug artifacts
err.txt

# Compiled probe/decoder binaries; their sources sit beside them as
# probe<N>.c, maptest.c, wiredecode.c.  Patterns, not a list: new probes
# are covered the moment they are added.
tools/probe/probe
tools/probe/probe[0-9]*
tools/probe/maptest
tools/wiredecode/wiredecode

# ...but the numbered probes are sources named probe<N>.c, which the
# pattern above would otherwise swallow along with the binaries.
!tools/probe/probe*.c
